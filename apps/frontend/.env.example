# Client-side API base — the browser calls this directly, so it must be
# reachable from the developer's machine (a published host port), never an
# in-network container service name.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-side backend base — Next.js's own server (SSR, API routes, the
# /api/auth and /api/backend rewrites in next.config.js) calls this. Set to
# http://backend:4000 when running the frontend as a container alongside a
# containerized backend on the same Compose network; localhost:4000 for
# bare-process local dev.
BACKEND_URL=http://localhost:4000
BACKEND_API_URL=http://localhost:4000/api

# Base URL of this frontend itself — used to construct the Better Auth
# client's base URL.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# n8n webhook base, exposed client-side for workflow-trigger UI.
NEXT_PUBLIC_N8N_WEBHOOK_BASE_URL=http://localhost:5678
