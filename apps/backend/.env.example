# Comma-separated platform administrator email addresses.
PLATFORM_ADMIN_EMAILS=
# Database
DATABASE_URL=

# Supabase
SUPABASE_URL=
SUPABASE_API_KEY=
SUPABASE_JWT_SECRET=

# Server
PORT=4000

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Must be the URL the backend itself is reached at (browsers/other services
# hit this directly for auth — http://localhost:4000 for local dev, whether
# bare-process or containerized with a published port).
BETTER_AUTH_URL=http://localhost:4000
# Origin the frontend is served from — used to build email links (invite,
# password reset) and CORS.
FRONTEND_URL=http://localhost:3000
# Optional extra origins (comma-separated) also trusted for CORS + auth —
# e.g. a tunnel domain like ngrok, or a staging domain.
ADDITIONAL_TRUSTED_ORIGINS=

# AWS / Storage — points at the local MinIO container by default (see
# infra/compose/minio.yml) so local dev doesn't need a real AWS account.
# AWS_S3_ENDPOINT is optional: unset it (and fill in real region/keys) to
# use actual AWS S3 instead.
STORAGE_PROVIDER=s3
AWS_S3_BUCKET_NAME=jibu-local
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_ENDPOINT=http://localhost:9000

# Vault — the backend runs bare-process (nx serve), so this points at
# Vault's published host port. Only use http://vault:8200 (the in-network
# service name) if you later run the backend itself as a container.
# root matches VAULT_DEV_ROOT_TOKEN_ID's default — dev mode only.
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=root
ENCRYPTION_MASTER_KEY=

# LLM providers
GOOGLE_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# LiveKit — these match the local OSS server's hardcoded dev keys in
# infra/livekit.yaml. Use a real LiveKit Cloud project's URL/keys instead
# for anything beyond local dev.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=jibuapikey
LIVEKIT_API_SECRET=JlqWGgv5djEifl4G2z-GLOWtdlWqFj4ZDjnmFuSrM44

# Speech
DEEPGRAM_API_KEY=
AZURE_RESOURCE_KEY=
AZURE_REGION=
AZURE_RESOURCE_ENDPOINT=
AZURE_SPEECH_TO_TEXT_ENDPOINT=
AZURE_TEXT_TO_SPEECH_ENDPOINT=
PLAYHT_USER_ID=
PLAYHT_API_KEY=
ELEVENLABS_API_KEY=

# Ollama (optional embedding backend)
# Use 11435 on Windows when the Docker Ollama container is mapped to 11435 to avoid
# clashing with a native Windows Ollama service on port 11434.
OLLAMA_URL=http://localhost:11434

# Vector store
QDRANT_URL=
# Embedding model + dimension. Dimensions are derived from the model registry;
# VECTOR_DIMENSION is only a fallback for unknown/legacy models not in the registry.
# Default to the local Ollama embedding model instead of a cloud provider.
EMBEDDING_MODEL=qwen3-embedding:0.6b
VECTOR_DIMENSION=1024

# Worker
WORKER_API_URL=

# n8n (tool integration backend only — NOT the conversation brain)
N8N_URL=
N8N_API_KEY=
N8N_BASE_URL=
N8N_WEBHOOK_BASE_URL=
N8N_OPENAI_CREDENTIAL_ID=
N8N_ANTHROPIC_CREDENTIAL_ID=
N8N_GOOGLE_CREDENTIAL_ID=

# WhatsApp Cloud API (Meta Graph API) — channel: whatsapp
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional fallback agent used when an inbound number cannot be resolved to an agent
WHATSAPP_DEFAULT_AGENT_ID=

# Phone number pool — Twilio account credentials go in the admin Credentials UI
# (Vault-backed), not here. This is the one platform-level setting that isn't a
# secret: the SID of a single Elastic SIP Trunk (created once, manually, in the
# Twilio console) that every purchased number gets attached to, since Twilio lets
# many numbers share one trunk. Leave unset and purchased numbers just won't route
# calls until an admin sets this and re-attaches them.
TWILIO_SHARED_TRUNK_SID=
