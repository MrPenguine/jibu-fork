# LiveKit connection — these match the local OSS server's hardcoded dev keys
# in infra/livekit.yaml. Use a real LiveKit Cloud project's URL/keys instead
# for anything beyond local dev (the code default otherwise falls back to a
# LiveKit Cloud placeholder, which won't reach the local server).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=jibuapikey
LIVEKIT_API_SECRET=JlqWGgv5djEifl4G2z-GLOWtdlWqFj4ZDjnmFuSrM44

# Backend brain endpoints (agent-config / execute-tool / call concurrency)
BACKEND_API_URL=http://localhost:4000/api

# Fallback agent id when room metadata does not carry one
DEFAULT_AGENT_ID=

# LLM providers (selected per-agent from backend config)
GOOGLE_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Speech (STT/TTS)
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# Azure Speech — only needed if an agent is configured to use the Azure
# speech plugin for STT/TTS.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus2

# Worker process
PORT=
HOST=
IDLE_TIMEOUT_SECONDS=
