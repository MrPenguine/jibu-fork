# Compose-level overrides for local infra credentials. These all have
# working zero-config defaults (see docker-compose.yml) — only set these if
# you want something other than the defaults, e.g. because you're running
# this somewhere less trusted than a laptop's loopback interface.
#
# This is separate from each app's own .env (apps/backend/.env,
# apps/frontend/.env, apps/worker/.env, apps/livekit-agent/.env) — those
# hold app-level secrets and API keys, this holds infra container creds.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jibu

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

VAULT_DEV_ROOT_TOKEN_ID=root

# Baked into the frontend's client bundle at build time (see
# apps/frontend/Dockerfile) — the browser calls this directly, so it must
# stay a published host port even when the frontend itself runs in a
# container.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_N8N_WEBHOOK_BASE_URL=http://localhost:5678
